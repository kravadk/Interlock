{
  "name": "interlock-firewall",
  "private": true,
  "version": "0.1.0",
  "description": "Mantle-native control plane for autonomous AI agents: pre-flight safety, policy enforcement, on-chain evidence, benchmark scoring, and developer integrations.",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.16.0",
    "pnpm": "10.32.1"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "node scripts/build-packages.mjs",
    "smoke:packages": "pnpm build:packages && node scripts/package-smoke.mjs",
    "smoke:pack": "pnpm build:packages && node scripts/pack-smoke.mjs",
    "smoke:consumer": "pnpm build:packages && node scripts/consumer-smoke.mjs",
    "smoke:all": "pnpm docs:links && pnpm submission:doctor && pnpm submission:doctor:test && pnpm submission:bundle:test && pnpm contracts:verify:test && pnpm contracts:verification-status:test && pnpm smoke:packages && pnpm smoke:pack && pnpm smoke:consumer && pnpm smoke:examples && pnpm web:smoke && pnpm deployment:manifest:test && pnpm deployment:manifest:env:test && pnpm deployment:report:test && pnpm live:verify:test && pnpm live:readiness:test && pnpm live:demo:test && pnpm keeper:finalize:test && pnpm --filter @interlock/contracts local:smoke && pnpm cli:built doctor --no-fail",
    "security:adversarial": "pnpm build:packages && node scripts/adversarial-smoke.mjs",
    "security:slither": "node scripts/slither-check.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "smoke:examples": "node scripts/examples-smoke.mjs",
    "web:smoke": "node scripts/web-smoke.mjs",
    "browser:qa": "node scripts/browser-qa.mjs",
    "screenshots:capture": "node scripts/capture-dashboard-screenshots.mjs",
    "with-env": "node scripts/env-run.mjs",
    "env:doctor": "node scripts/env-run.mjs pnpm cli doctor --no-fail",
    "deployment:doctor": "node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env pnpm cli doctor --no-fail",
    "deployment:manifest:doctor": "node scripts/deployment-manifest-doctor.mjs",
    "deployment:manifest:test": "node scripts/deployment-manifest-doctor.test.mjs",
    "deployment:manifest:env": "node scripts/deployment-manifest-env.mjs",
    "deployment:manifest:env:test": "node scripts/deployment-manifest-env.test.mjs",
    "deployment:report": "node scripts/deployment-report.mjs",
    "deployment:report:test": "node scripts/deployment-report.test.mjs",
    "live:verify": "node scripts/live-deployment-verify.mjs",
    "live:verify:test": "node scripts/live-deployment-verify.test.mjs",
    "live:readiness": "node scripts/live-alpha-readiness.mjs",
    "live:readiness:test": "node scripts/live-alpha-readiness.test.mjs",
    "live:services": "node scripts/live-services-smoke.mjs",
    "live:demo": "node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/live-demo.mjs",
    "live:demo:check": "node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/live-demo.mjs --check-only",
    "live:demo:test": "node scripts/live-demo.test.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "contracts:verify": "node scripts/verify-etherscan-v2.mjs",
    "contracts:verify:export": "node scripts/verify-etherscan-v2.mjs --export-dir verification-artifacts/mantle-sepolia",
    "contracts:verify:test": "node scripts/verify-etherscan-v2.test.mjs",
    "contracts:verification-status": "node scripts/contract-verification-status.mjs",
    "contracts:verification-status:test": "node scripts/contract-verification-status.test.mjs",
    "docs:links": "node scripts/docs-link-check.mjs",
    "submission:doctor": "node scripts/submission-doctor.mjs",
    "submission:doctor:live": "node scripts/submission-doctor.mjs --require-live",
    "submission:doctor:final": "node scripts/submission-doctor.mjs --require-live --require-final-links",
    "submission:doctor:test": "node scripts/submission-doctor.test.mjs",
    "submission:bundle": "node scripts/submission-bundle.mjs",
    "submission:bundle:live": "node scripts/submission-bundle.mjs --require-live",
    "submission:bundle:test": "node scripts/submission-bundle.test.mjs",
    "doctor": "node scripts/env-run.mjs pnpm cli doctor --no-fail",
    "agentation:mcp": "npx -y agentation-mcp server",
    "mcp": "pnpm --filter @interlock/mcp start",
    "mcp:check": "pnpm --filter @interlock/mcp check",
    "deploy:mantle-sepolia": "node scripts/env-run.mjs pnpm --filter @interlock/contracts deploy:mantle-sepolia",
    "live:smoke": "pnpm build:packages && node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env pnpm --filter @interlock/contracts live:smoke",
    "live:full-test": "pnpm build:packages && node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/live-full-product-test.mjs",
    "live:adversarial": "pnpm build:packages && node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/live-adversarial.mjs",
    "keeper:finalize": "pnpm build:packages && node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/keeper-finalize.mjs",
    "keeper:finalize:check": "pnpm build:packages && node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/keeper-finalize.mjs --check-only",
    "keeper:finalize:test": "node scripts/keeper-finalize.test.mjs",
    "indexer:live": "node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env pnpm indexer",
    "web:live": "node scripts/env-run.mjs --env-file deployments/mantle-sepolia/latest.env node scripts/web-live.mjs",
    "indexer:env": "node scripts/env-run.mjs pnpm indexer",
    "check": "pnpm build:packages && pnpm -r --workspace-concurrency=1 check",
    "test": "pnpm build:packages && pnpm -r test",
    "test:coverage": "pnpm --filter @interlock/web test:coverage && pnpm --filter @interlock/firewall-sdk test:coverage && pnpm --filter @interlock/indexer test:coverage && pnpm --filter @interlock/cli test:coverage && pnpm --filter @interlock/contracts test:coverage",
    "web:e2e": "pnpm --filter @interlock/web e2e",
    "dev": "pnpm build:packages && pnpm --filter @interlock/web dev",
    "indexer": "pnpm --filter @interlock/indexer dev",
    "cli": "pnpm build:packages && node packages/cli/dist/index.js",
    "cli:built": "node packages/cli/dist/index.js",
    "cli:dev": "pnpm --filter @interlock/cli start --",
    "compile:contracts": "pnpm --filter @interlock/contracts compile",
    "demo": "pnpm --filter @interlock/agent-demo demo",
    "agent:benchmark": "pnpm --filter @interlock/agent-demo benchmark",
    "release:check": "pnpm check && pnpm test && pnpm security:secrets && pnpm smoke:pack && pnpm smoke:consumer && pnpm release:pack && pnpm release:draft",
    "release:pack": "pnpm build:packages && node scripts/release-pack.mjs",
    "release:draft": "node scripts/release-draft.mjs",
    "release:dry": "pnpm build:packages && pnpm --filter @interlock/shared --filter @interlock/firewall-sdk publish --dry-run --no-git-checks",
    "release:publish": "pnpm build:packages && changeset publish",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release:changeset:check": "node scripts/changeset-status.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "viem": "^2.51.3",
    "vitest": "^4.1.9"
  }
}

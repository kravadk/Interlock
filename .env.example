# Mantle Sepolia
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
PRIVATE_KEY=
# Attestor (off-chain firewall signer). Recording now uses ActionAttestationV4 (committee-verified):
# ATTESTOR_PRIVATE_KEY (server-side, used by /api/attest; never exposed to the browser) MUST be an
# AttestorCommittee member, otherwise V4 rejects the signature. The 1-of-1 committee member is the
# deployer; add more members on-chain for true m-of-n. Leave blank to disable the dashboard record
# button (the agent-demo records server-side with PRIVATE_KEY = the committee member).
ATTESTOR_ADDRESS=
ATTESTOR_PRIVATE_KEY=

# AI layer (Phase 4, advisory-only). Server-side key used by /api/ai to explain decisions,
# draft policies from natural language, and summarize block patterns. NEVER exposed to the browser.
# Leave empty to disable the AI layer entirely - the app falls back to deterministic behavior.
ANTHROPIC_API_KEY=

# Optional external error sink. When set, error reports carry sink="sentry"; wiring the actual
# @sentry/nextjs transport is user-owned (kept out by default to stay dependency-light). Server-only,
# never exposed to the browser. Leave empty to log errors via the structured logger only.
SENTRY_DSN=

# Web API dampening. In-memory per-instance token buckets; set RATE_LIMIT_DISABLED=true for local
# diagnostics only. Health is intentionally not rate-limited.
RATE_LIMIT_RPM=
RATE_LIMIT_AI_RPM=20
RATE_LIMIT_ATTEST_RPM=30
RATE_LIMIT_DEMO_RPM=10
RATE_LIMIT_RPC_RPM=120
RATE_LIMIT_DISABLED=

# Deployed contracts
AGENT_REGISTRY=
POLICY_REGISTRY=
ACTION_ATTESTATION=
# PolicyGuardedExecutor - on-chain enforcement guard (Phase 9). Agents route execution through it.
POLICY_GUARDED_EXECUTOR=
# DisputeEscrow - two-sided bond + slashing for the dispute window (Phase 10).
DISPUTE_ESCROW=
# Phase 11 extras: AttestorCommittee (m-of-n attestation) + ReputationOracle (agent score/tier).
ATTESTOR_COMMITTEE=
REPUTATION_ORACLE=
ACTION_TARGET=
ACTION_VALUE_MNT=0
TEST_STRATEGY_VAULT=
TEST_STRATEGY_ROUTER=

# Default live demo IDs
AGENT_ID=
POLICY_ID=

# Indexer
FROM_BLOCK=0
PORT=8787
INDEXER_URL=
# Optional override. Live deployment env files use .interlock-indexer-<deployment>.sqlite by default.
INDEXER_DB_PATH=.interlock-indexer-dev.sqlite
AUTO_SYNC=true
SYNC_INTERVAL_MS=60000
INDEXER_BLOCK_CHUNK_SIZE=250000
WEBHOOK_URL=
WEBHOOK_SECRET=
# Events: allow, block, simulation_failed, policy_changed, benchmark_failed (comma-separated).
WEBHOOK_EVENTS=block,simulation_failed
# Delivery format: generic (signed JSON, default) | discord | slack | telegram.
# Non-generic formats post a formatted chat message to WEBHOOK_URL; telegram also needs TELEGRAM_CHAT_ID.
WEBHOOK_FORMAT=generic
TELEGRAM_CHAT_ID=

# Dashboard
# Show AI affordances in the UI. Set to "false" to hide them entirely (the /api/ai route still
# 503s without a server key). This is a UI hint only - no secret, safe to expose.
NEXT_PUBLIC_AI_ENABLED=
NEXT_PUBLIC_MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# Point at a running indexer to load the dashboard in 1 request (falls back to RPC if empty).
# Dev: http://localhost:8787  |  Prod: your hosted indexer URL  (see packages/indexer/README.md)
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_AGENT_REGISTRY=
NEXT_PUBLIC_POLICY_REGISTRY=
NEXT_PUBLIC_ACTION_ATTESTATION=
NEXT_PUBLIC_POLICY_GUARDED_EXECUTOR=
NEXT_PUBLIC_DISPUTE_ESCROW=
NEXT_PUBLIC_REPUTATION_ORACLE=

# Committee-verified recording (ActionAttestationV4) + on-chain ERC-20 token-rule enforcement
# (TokenGuardedExecutor). Implemented + tested; populate after deploy (scripts/deploy-v4.ts,
# scripts/deploy-token-guard.ts). ATTESTOR_COMMITTEE feeds deploy-v4 if not in shared addresses.
NEXT_PUBLIC_ACTION_ATTESTATION_V4=
NEXT_PUBLIC_TOKEN_GUARDED_EXECUTOR=
ATTESTOR_COMMITTEE=
TOKEN_GUARDED_EXECUTOR=

# Official ERC-8004 "Trustless Agents" registries. These DEFAULT to the verified Mantle Sepolia
# deployment (Identity 0x8004A3718bD35CF767BC0E718bf21Ec4073502f0, Reputation
# 0x8004B1BcAb4228199Af728fF90Ed23dCc9b0Fa63) — leave blank to use them, or override for another
# chain/fork. Server-side equivalents: ERC8004_IDENTITY_REGISTRY / ERC8004_REPUTATION_REGISTRY.
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=
NEXT_PUBLIC_ERC8004_REPUTATION_REGISTRY=
ERC8004_IDENTITY_REGISTRY=
ERC8004_REPUTATION_REGISTRY=

NEXT_PUBLIC_ACTION_ATTESTATION_FROM_BLOCK=0
NEXT_PUBLIC_DEFAULT_AGENT_ID=
NEXT_PUBLIC_DEFAULT_POLICY_ID=
NEXT_PUBLIC_DEFAULT_ACTION_TARGET=
NEXT_PUBLIC_DEFAULT_SELECTOR=0x2de5aaf7
NEXT_PUBLIC_TEST_STRATEGY_VAULT=
NEXT_PUBLIC_TEST_STRATEGY_ROUTER=

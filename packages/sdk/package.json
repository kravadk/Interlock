{
  "name": "@interlock/firewall-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for Interlock Firewall pre-flight policy checks, simulation, and on-chain attestations on Mantle Sepolia.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "interlock",
    "mantle",
    "ai-agents",
    "firewall",
    "viem",
    "policy"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kravadk/interlock"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@interlock/shared": "workspace:*",
    "viem": "^2.53.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}

{
  "name": "@interlock/indexer",
  "version": "0.1.0",
  "description": "HTTP read API and SQLite-backed event indexer for Interlock Firewall agents, policies, and action attestations.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "interlock",
    "mantle",
    "indexer",
    "events",
    "sqlite"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@interlock/firewall-sdk": "workspace:*",
    "@interlock/shared": "workspace:*",
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}

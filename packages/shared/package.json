{
  "name": "@interlock/shared",
  "version": "0.1.0",
  "description": "Shared Mantle Sepolia chain config, deployed addresses, ABIs, and constants for Interlock Firewall.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "interlock",
    "mantle",
    "abis",
    "contracts",
    "viem"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kravadk/interlock"
  },
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm check"
  },
  "dependencies": {
    "viem": "^2.30.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
